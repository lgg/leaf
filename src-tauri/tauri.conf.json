{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leaf",
  "version": "1.10.3",
  "identifier": "io.github.lgg.leaf",
  "build": {
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Leaf",
        "width": 1160,
        "height": 820,
        "minWidth": 520,
        "minHeight": 420,
        "label": "main",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "txt"
        ],
        "name": "Leaf text document",
        "description": "Markdown / plain text",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ]
  }
}
