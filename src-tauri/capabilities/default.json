{
  "identifier": "main",
  "description": "Only the bundled main editor may invoke the explicitly registered Rust commands. No unrestricted fs or shell access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging"
  ]
}
